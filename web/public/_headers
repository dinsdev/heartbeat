# Design call 16 (R40). Cloudflare applies every rule whose pattern matches,
# so the policy below reaches the page, the Worker script and every file.
# No X-Frame-Options: frame-ancestors decides who may embed the demo.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'self' https://dins.dev https://*.din.workers.dev
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Vite's output: every name carries a content hash.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The demo data's name.HASH.ext files. manifest.json has no hash and no
# second dot, so it keeps Cloudflare's default revalidation.
/data/:stem.:hash.:ext
  Cache-Control: public, max-age=31536000, immutable
